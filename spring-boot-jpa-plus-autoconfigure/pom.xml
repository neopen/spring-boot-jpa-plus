
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.neopen</groupId>
        <artifactId>spring-boot-jpa-plus</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>spring-boot-jpa-plus-autoconfigure</artifactId>

    <name>Spring Boot JPA Plus AutoConfigure</name>

    <description>
        Spring Boot automatic configuration for Spring Boot JPA Plus.
    </description>

    <dependencies>

        <!--
            JPA Plus 核心模块。

            提供：
            1. JpaPlusDao
            2. AbstractJpaPlusDao
            3. JpaPlusQueryBuilder
            4. JpaPlusHqlExecutor
            5. JpaPlusSqlExecutor
            6. BatchOperation

            自动配置模块不重新实现这些能力，
            而是负责将它们注册为 Spring Bean。
        -->
        <dependency>
            <groupId>io.github.neopen</groupId>
            <artifactId>spring-boot-jpa-plus-core</artifactId>
        </dependency>

        <!--
            Spring Boot 自动配置基础能力。

            提供：
            1. @AutoConfiguration
            2. @ConditionalOnClass
            3. @ConditionalOnMissingBean
            4. @ConditionalOnProperty
            5. @ConditionalOnBean
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>

        <!--
            配置属性处理器。

            用于在 IDE 中为 application.yml 提供配置提示、
            自动补全和属性元数据。

            该依赖仅在编译阶段发挥作用，
            不需要作为普通运行时依赖传递给用户。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>

        <!--
            Jakarta Persistence API。

            core 已经通过 spring-boot-starter-data-jpa
            引入该 API，这里无需再次声明。
        -->

        <!-- 单元测试 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

</project>
