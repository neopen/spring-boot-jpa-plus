<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.neopen</groupId>
    <artifactId>spring-boot-jpa-plus</artifactId>
    <version>0.8.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Spring Boot JPA Plus</name>
    <description>
        An enhanced JPA toolkit for Spring Boot applications.
    </description>
    <url>https://github.com/neopen/spring-boot-jpa-plus</url>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
            <comments>Copyright 2026 neopen</comments>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>neopen</id>
            <name>NeoPen</name>
            <url>https://github.com/neopen</url>
        </developer>
    </developers>

    <scm>
        <connection>
            scm:git:https://github.com/neopen/spring-boot-jpa-plus.git
        </connection>
        <developerConnection>
            scm:git:ssh://git@github.com/neopen/spring-boot-jpa-plus.git
        </developerConnection>
        <url>https://github.com/neopen/spring-boot-jpa-plus</url>
    </scm>


    <distributionManagement>
        <repository>
            <id>github</id>
            <name>GitHub Packages</name>
            <url>https://maven.pkg.github.com/neopen/spring-boot-jpa-plus</url>
        </repository>
    </distributionManagement>


    <properties>
        <java.version>17</java.version>
        <maven.compiler.release>${java.version}</maven.compiler.release>

        <spring-boot.version>3.4.13</spring-boot.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <lombok.version>1.18.42</lombok.version>
        <hutool.version>5.8.41</hutool.version>
        <fastjson2.version>2.0.53</fastjson2.version>
        <jacoco.version>0.8.12</jacoco.version>
    </properties>


    <modules>
        <!--        核心模块-->
        <module>spring-boot-jpa-plus-core</module>
        <module>spring-boot-jpa-plus-autoconfigure</module>
        <module>spring-boot-jpa-plus-starter</module>
        <module>spring-boot-jpa-plus-convert</module>

        <!-- 扩展模块 -->
        <module>spring-boot-jpa-plus-extension</module>

        <!-- 基准测试（不发布） -->
        <module>spring-boot-jpa-plus-benchmarks</module>

        <!-- 示例项目 -->
<!--        <module>examples/spring-boot-jpa-plus-demo</module>-->
    </modules>


    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <dependency>
                <groupId>io.github.neopen</groupId>
                <artifactId>spring-boot-jpa-plus-core</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>io.github.neopen</groupId>
                <artifactId>spring-boot-jpa-plus-autoconfigure</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>io.github.neopen</groupId>
                <artifactId>spring-boot-jpa-plus-starter</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>io.github.neopen</groupId>
                <artifactId>spring-boot-jpa-plus-convert</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>io.github.neopen</groupId>
                <artifactId>spring-boot-jpa-plus-extension</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>com.google.guava</groupId>
                <artifactId>guava</artifactId>
                <version>33.4.8-jre</version>
            </dependency>

            <dependency>
                <groupId>com.alibaba.fastjson2</groupId>
                <artifactId>fastjson2</artifactId>
                <version>${fastjson2.version}</version>
            </dependency>

        </dependencies>
    </dependencyManagement>

    <profiles>
        <profile>
            <id>central</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>0.12.0</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <deploymentName>
                                Spring Boot JPA Plus ${project.version}
                            </deploymentName>
                            <autoPublish>true</autoPublish>
                            <waitUntil>published</waitUntil>
                        </configuration>
                    </plugin>

                    <!-- 依赖协议扫描（CI 用） -->
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>license-maven-plugin</artifactId>
                        <version>2.9.0</version>
                        <configuration>
                            <outputDirectory>${project.build.directory}/licenses</outputDirectory>
                            <licensesOutputFile>${project.build.directory}/licenses/third-party.txt</licensesOutputFile>
                            <excludedScopes>test</excludedScopes>
                        </configuration>
                        <executions>
                            <execution>
                                <id>aggregate-licenses</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>aggregate-add-third-party</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>

                    <!-- 源文件头自动插入（可选但推荐） -->
                    <plugin>
                        <groupId>com.mycila</groupId>
                        <artifactId>license-maven-plugin</artifactId>
                        <version>4.6</version>
                        <configuration>
                            <header>${maven.multiModuleProjectDirectory}/HEADER.txt</header>
                            <properties>
                                <owner>neopen</owner>
                                <year>2026</year>
                            </properties>
                            <includes>
                                <include>src/main/java/**/*.java</include>
                                <include>src/test/java/**/*.java</include>
                            </includes>
                            <excludes>
                                <exclude>**/target/**</exclude>
                            </excludes>
                        </configuration>
                        <executions>
                            <execution>
                                <id>check-license-header</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>check</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.13.0</version>
                    <configuration>
                        <release>${maven.compiler.release}</release>
                        <encoding>UTF-8</encoding>
                        <parameters>true</parameters>
                    </configuration>
                </plugin>

                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                </plugin>

                <!-- 使用 JUnit 5 需要 Surefire 3.x -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.2.5</version>
                </plugin>

                <!-- 覆盖率采集与门槛校验 -->
                <plugin>
                    <groupId>org.jacoco</groupId>
                    <artifactId>jacoco-maven-plugin</artifactId>
                    <version>${jacoco.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <!-- 发布源码包 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <version>3.3.1</version>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <goals>
                            <goal>jar-no-fork</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- 发布 Javadoc -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <version>3.11.2</version>
                <executions>
                    <execution>
                        <id>attach-javadocs</id>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- GPG 签名 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-gpg-plugin</artifactId>
                <version>3.2.8</version>
                <executions>
                    <execution>
                        <id>sign-artifacts</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>sign</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <gpgArguments>
                        <arg>--pinentry-mode</arg>
                        <arg>loopback</arg>
                    </gpgArguments>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
